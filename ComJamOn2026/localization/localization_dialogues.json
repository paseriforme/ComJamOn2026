          "Text": "negarse",
          "Next": 25
        },
        {
          "ID": 25,
          "Type": "DIALOGUE",
          "Character": "Tronca",
          "Text": "¡Pues hasta luego, Lucas!",
          "Next": 26
        },
        {
          "ID": 26,
          "Type": "END",
