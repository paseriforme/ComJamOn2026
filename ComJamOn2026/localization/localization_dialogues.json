          "Text": "aceptar",
          "Next": 23
        },
        {
          "ID": 23,
          "Type": "END",
          "Character": "Tronca",
          "Text": "Mete cuarta y acelera",
          "Next": null
        },
        {
          "ID": 24,
          "Type": "ACTION",
