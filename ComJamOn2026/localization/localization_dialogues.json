          "Next": 5
        },
        {
          "ID": 5,
          "Type": "END",
          "Character": "Manager",
          "Text": "¡Qué vivan Las Magnolias!",
          "Next": null
        },
        {
          "ID": 6,
          "Type": "ACTION",
          "Character": "",
          "Text": "negarse",
          "Next": 7
        },
        {
          "ID": 7,
          "Type": "END",
          "Character": "Manager",
          "Text": "Vuelve cuando estés lista, sin presión",
          "Next": null
        }
      ]
    },
    {
      "DialogueID": 1,
      "Texts": [
        {
          "ID": 8,
          "Type": "START",
          "Character": "Colega",
          "Text": "¿Qué pasa, colega?",
          "Next": 45
        },
        {
          "ID": 45,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¿Cómo estás? Tienes mala cara",
          "Next": 46
        },
        {
          "ID": 46,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡No me digas que se te ha olvidado el single!",
          "Next": 47
        },
        {
          "ID": 47,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡Yo tengo un truco para recordar las cosas olvidadas!",
          "Next": 58
        },
        {
          "ID": 58,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Lo leí en un libro de mi padre",
          "Next": 59
        },
        {
          "ID": 59,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "«Consejos para el mileurista: Cómo meditar»",
          "Next": 48
        },
        {
          "ID": 48,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Tienes que quedarte quieta, poner los ojos bizcos y...",
          "Next": 49
        },
        {
          "ID": 49,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "A ver, espera, cómo era...",
          "Next": 50
        },
        {
          "ID": 50,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Ojos bizcos, cara de pan, mente en blanco...",
          "Next": 51
        },
        {
          "ID": 51,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Eso lo tienes todo ya y no lo estás recordando...",
          "Next": 52
        },
        {
          "ID": 52,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Debe ser otra cosa...",
          "Next": 53
        },
        {
          "ID": 53,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Pies callosos, mal aliento... ¡No! ¡Algo que no tengas!",
          "Next": 54
        },
        {
          "ID": 54,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Jo, tía, de verdad que no me acuerdo...",
          "Next": 55
        },
        {
          "ID": 55,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Se me ha escapado el pensamiento...",
          "Next": 56
        },
        {
          "ID": 56,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¿De qué estábamos hablando?",
          "Next": 57
        },
        {
          "ID": 57,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Da igual...",
          "Next": 9
        },
        {
          "ID": 9,
          "Type": "DECISION",
          "Character": "Colega",
          "Text": "¿Practicamos la primera estrofa y voy pensando?",
          "Next": 10,
          "Options": [
            {
              "Text": "Sí",
              "Next": 10
            },
            {
              "Text": "No",
              "Next": 12
            }
          ]
        },
        {
          "ID": 10,
          "Type": "ACTION",
          "Character": "",
          "Text": "aceptar",
          "Next": 60
        },
        {
          "ID": 60,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡Esa es la actitud! ¿Debería escribir un libro yo?",
          "Next": 11
        },
        {
          "ID": 11,
          "Type": "END",
          "Character": "Colega",
          "Text": "«Consejos para la guitarrista desesperada: Déjate llevar»",
          "Next": null
        },
        {
          "ID": 12,
          "Type": "ACTION",
          "Character": "",
          "Text": "negarse",
          "Next": 13
        },
        {
          "ID": 13,
          "Type": "END",
          "Character": "Colega",
          "Text": "Si me vuelves a necesitar ya sabes dónde estoy",
          "Next": null
        }
      ]
    },
