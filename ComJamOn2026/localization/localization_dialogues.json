{
  "Dialogues": [
    {
      "DialogueID": 0,
      "Texts": [
        {
          "ID": 2,
          "Type": "START",
          "Character": "Manager",
          "Text": "¡Hola, hola!",
          "Next": 33
        },
        {
          "ID": 33,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Ya está todo preparado",
          "Next": 34
        },
        {
          "ID": 34,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Me han dicho las chicas que no te encuentras bien",
          "Next": 35
        },
        {
          "ID": 35,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Todo bien con el single ¿no?",
          "Next": 36
        },
        {
          "ID": 36,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "...",
          "Next": 37
        },
        {
          "ID": 37,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Llevamos TODA la semana ensayándolo",
          "Next": 38
        },
        {
          "ID": 38,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Más os vale que salga bien",
          "Next": 39
        },
        {
          "ID": 39,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "En esta sala no toca cualquiera",
          "Next": 40
        },
        {
          "ID": 40,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Olvídalo, ¡os va a ir genial!",
          "Next": 41
        },
        {
          "ID": 41,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¿Cómo no os va a ir genial?",
          "Next": 42
        },
        {
          "ID": 42,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¿Verdad?",
          "Next": 43
        },
        {
          "ID": 43,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¡¡¿Verdad?!!",
          "Next": 44
        },
        {
          "ID": 44,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "...",
          "Next": 3
        },
        {
          "ID": 3,
          "Type": "DECISION",
          "Character": "Manager",
          "Text": "Bueno, qué, ¿Listas para salir?",
          "Next": 4,
          "Options": [
            {
              "Text": "Sí",
              "Next": 4
            },
            {
              "Text": "No",
              "Next": 6
            }
          ]
        },
        {
          "ID": 4,
          "Type": "ACTION",
          "Character": "",
          "Text": "aceptar",
          "Next": 5
        },
        {
          "ID": 5,
          "Type": "END",
          "Character": "Manager",
          "Text": "¡Qué vivan Las Magnolias!",
          "Next": null
        },
        {
          "ID": 6,
          "Type": "ACTION",
          "Character": "",
          "Text": "negarse",
          "Next": 7
        },
        {
          "ID": 7,
          "Type": "END",
          "Character": "Manager",
          "Text": "Vuelve cuando estés lista, sin presión",
          "Next": null
        }
      ]
    },
    {
      "DialogueID": 1,
      "Texts": [
        {
          "ID": 8,
          "Type": "START",
          "Character": "Colega",
          "Text": "¿Qué pasa, colega?",
          "Next": 45
        },
        {
          "ID": 45,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¿Cómo estás? Tienes mala cara",
          "Next": 46
        },
        {
          "ID": 46,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡No me digas que se te ha olvidado el single!",
          "Next": 47
        },
        {
          "ID": 47,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡Yo tengo un truco para recordar las cosas olvidadas!",
          "Next": 58
        },
        {
          "ID": 58,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Lo leí en un libro de mi padre",
          "Next": 59
        },
        {
          "ID": 59,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "«Consejos para el mileurista: Cómo meditar»",
          "Next": 48
        },
        {
          "ID": 48,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Tienes que quedarte quieta, poner los ojos bizcos y...",
          "Next": 49
        },
        {
          "ID": 49,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "A ver, espera, cómo era...",
          "Next": 50
        },
        {
          "ID": 50,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Ojos bizcos, cara de pan, mente en blanco...",
          "Next": 51
        },
        {
          "ID": 51,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Eso lo tienes todo ya y no lo estás recordando...",
          "Next": 52
        },
        {
          "ID": 52,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Debe ser otra cosa...",
          "Next": 53
        },
        {
          "ID": 53,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Pies callosos, mal aliento... ¡No! ¡Algo que no tengas!",
          "Next": 54
        },
        {
          "ID": 54,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Jo, tía, de verdad que no me acuerdo...",
          "Next": 55
        },
        {
          "ID": 55,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Se me ha escapado el pensamiento...",
          "Next": 56
        },
        {
          "ID": 56,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¿De qué estábamos hablando?",
          "Next": 57
        },
        {
          "ID": 57,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "Da igual...",
          "Next": 9
        },
        {
          "ID": 9,
          "Type": "DECISION",
          "Character": "Colega",
          "Text": "¿Practicamos la primera estrofa y voy pensando?",
          "Next": 10,
          "Options": [
            {
              "Text": "Sí",
              "Next": 10
            },
            {
              "Text": "No",
              "Next": 12
            }
          ]
        },
        {
          "ID": 10,
          "Type": "ACTION",
          "Character": "",
          "Text": "aceptar",
          "Next": 60
        },
        {
          "ID": 60,
          "Type": "DIALOGUE",
          "Character": "Colega",
          "Text": "¡Esa es la actitud! ¿Debería escribir un libro yo?",
          "Next": 11
        },
        {
          "ID": 11,
          "Type": "END",
          "Character": "Colega",
          "Text": "«Consejos para la guitarrista desesperada: Déjate llevar»",
          "Next": null
        },
        {
          "ID": 12,
          "Type": "ACTION",
          "Character": "",
          "Text": "negarse",
          "Next": 13
        },
        {
          "ID": 13,
          "Type": "END",
          "Character": "Colega",
          "Text": "Si me vuelves a necesitar ya sabes dónde estoy",
          "Next": null
        }
      ]
    },
    {
      "DialogueID": 2,
      "Texts": [
        {
          "ID": 14,
          "Type": "START",
          "Character": "Chavala",
          "Text": "¿Y esos pelos, tía? ¿Todo bien?",
          "Next": 61
        },
        {
          "ID": 61,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "¿No te sabes la canción? ¿Y eso qué más da?",
          "Next": 62
        },
        {
          "ID": 62,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Las Magnolias fluyen, tía, ¡como el viento!",
          "Next": 63
        },
        {
          "ID": 63,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "El público te electrifica, tía",
          "Next": 64
        },
        {
          "ID": 64,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "¡Física teórica puesta en práctica!",
          "Next": 65
        },
        {
          "ID": 65,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Como aquella vez en El Pradillo",
          "Next": 66
        },
        {
          "ID": 66,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Tronca se inventó la letra",
          "Next": 67
        },
        {
          "ID": 67,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Y las demás seguimos su voz",
          "Next": 68
        },
        {
          "ID": 68,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Como una sirena, tía, místico que te cagas",
          "Next": 69
        },
        {
          "ID": 69,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Tú también puedes ser hoy una criatura mitológica",
          "Next": 70
        },
        {
          "ID": 70,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Un minotauro...",
          "Next": 71
        },
        {
          "ID": 71,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "O un kraken...",
          "Next": 72
        },
        {
          "ID": 72,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "¡Lo que quieras!",
          "Next": 73
        },
        {
          "ID": 73,
          "Type": "DIALOGUE",
          "Character": "Chavala",
          "Text": "Si no te convence te puedo ayudar a practicar el puente",
          "Next": 15
        },
        {
          "ID": 15,
          "Type": "DECISION",
          "Character": "Chavala",
          "Text": "¿Quieres?",
          "Next": 16,
          "Options": [
            {
              "Text": "Sí",
              "Next": 16
            },
            {
              "Text": "No",
              "Next": 18
            }
          ]
        },
        {
          "ID": 16,
          "Type": "ACTION",
          "Character": "",
          "Text": "aceptar",
          "Next": 17
        },
        {
          "ID": 17,
          "Type": "END",
          "Character": "Chavala",
          "Text": "Al lío",
          "Next": null
        },
        {
          "ID": 18,
          "Type": "ACTION",
          "Character": "",
          "Text": "negarse",
          "Next": 19
        },
        {
          "ID": 19,
          "Type": "END",
          "Character": "Chavala",
          "Text": "Eso es tía, estás hecha toda una dragona",
          "Next": null
        }
      ]
    },
    {
      "DialogueID": 3,
      "Texts": [
