          "Text": "¿Qué pasa tron?",
          "Next": 21
        },
        {
          "ID": 21,
          "Type": "DECISION",
          "Character": "Tronca",
          "Text": "¿Le damos a los estribillos?",
          "Next": 22,
          "Options": [
            {
              "Text": "Sí",
