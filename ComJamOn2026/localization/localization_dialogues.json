        {
          "ID": 2,
          "Type": "START",
          "Character": "Manager",
          "Text": "¡Hola, hola!",
          "Next": 33
        },
        {
          "ID": 33,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Ya está todo preparado",
          "Next": 34
        },
        {
          "ID": 34,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Me han dicho las chicas que no te encuentras bien",
          "Next": 35
        },
        {
          "ID": 35,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Todo bien con el single ¿no?",
          "Next": 36
        },
        {
          "ID": 36,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "...",
          "Next": 37
        },
        {
          "ID": 37,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Llevamos TODA la semana ensayándolo",
          "Next": 38
        },
        {
          "ID": 38,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Más os vale que salga bien",
          "Next": 39
        },
        {
          "ID": 39,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "En esta sala no toca cualquiera",
          "Next": 40
        },
        {
          "ID": 40,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "Olvídalo, ¡os va a ir genial!",
          "Next": 41
        },
        {
          "ID": 41,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¿Cómo no os va a ir genial?",
          "Next": 42
        },
        {
          "ID": 42,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¿Verdad?",
          "Next": 43
        },
        {
          "ID": 43,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "¡¡¿Verdad?!!",
          "Next": 44
        },
        {
          "ID": 44,
          "Type": "DIALOGUE",
          "Character": "Manager",
          "Text": "...",
          "Next": 3
        },
        {
          "ID": 3,
          "Type": "DECISION",
          "Character": "Manager",
          "Text": "Bueno, qué, ¿Listas para salir?",
          "Next": 4,
          "Options": [
            {
              "Text": "Sí",
              "Next": 4
            },
            {
              "Text": "No",
              "Next": 6
            }
